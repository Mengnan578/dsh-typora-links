{
  "name": "dsh-typora-links",
  "version": "0.1.1",
  "description": "Open Markdown file links from the DSH conversation in Typora instead of the in-app preview.",
  "license": "MIT",
  "author": "Mengnan578",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mengnan578/dsh-typora-links.git"
  },
  "homepage": "https://github.com/Mengnan578/dsh-typora-links#readme",
  "bugs": {
    "url": "https://github.com/Mengnan578/dsh-typora-links/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "typora",
    "markdown",
    "open-with"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
